<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>be-batch</groupId>
	<artifactId>be-batch</artifactId>
	<version>1.0.10</version>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath />
	</parent>
	<properties>
		<java.version>25</java.version>
		<!-- Security: patch delle versioni jackson del BOM di Boot 4.1 (CVE-2026-59889, CVE-2026-54515,
		     GHSA-mhm7-754m-9p8w). -->
		<jackson-2-bom.version>2.21.5</jackson-2-bom.version>
		<jackson-bom.version>3.1.5</jackson-bom.version>
		<bouncycastle.version>1.84</bouncycastle.version>
        <!-- Security: log4j 2.25.4 del BOM di Boot 4.1 e' esposto a GHSA-qv9r-c865-cp47
             (encoding errato di float non-finiti in MapMessage). Corretto in 2.25.5. -->
        <log4j2.version>2.25.5</log4j2.version>
	</properties>

	<!-- sshj 0.38.0 dichiara BouncyCastle 1.75, che porta 7 CVE (Marvin attack CVE-2024-30171,
	     DNS poisoning CVE-2024-34447, LDAP injection CVE-2026-0636, loop infinito CVE-2024-30172...).
	     BC e' API-stabile sulla linea jdk18on: si allineano tutti e tre gli artifact a 1.84. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Dipendenza custom locale/remota, verifica gruppoId -->
		<dependency>
			<groupId>commonBase</groupId>
			<artifactId>commonBase</artifactId>
			<version>0.0.2-SNAPSHOT</version>
		</dependency>

		<!-- spring-boot-starter-aop rimosso: non è usato (nessun @Aspect) e il BOM di Spring Boot 4.1 non
		     ne gestisce più la versione. Il proxy per @Transactional arriva comunque via spring-aop
		     transitivo da data-jpa/web. -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Coordinate nuove (com.mysql, versione gestita dal parent Boot), come negli altri moduli:
		     le vecchie mysql:mysql-connector-java sono ferme alla 8.0.33 e non ricevono aggiornamenti. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
		</dependency>

		<!-- springdoc 3.x è la serie compatibile con Spring Boot 4 (la 2.x si ferma a Boot 3). -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<!-- Allineate a commonBase/be-anag: versioni diverse dello stesso jar nel classpath
		     causerebbero conflitti di risoluzione col JwtUtil condiviso. -->
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.5.0</version>
		</dependency>

		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>1.12.0</version>
		</dependency>

		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Client SFTP per le "Schedulazioni SFTP". sshj ha un'API moderna e non richiede provider
		     crittografici esterni per gli algoritmi correnti (JSch non e' piu' mantenuto).
		     NB: e' una dipendenza NUOVA, non presente nel repository locale: la prima build deve avere rete. -->
		<dependency>
			<groupId>com.hierynomus</groupId>
			<artifactId>sshj</artifactId>
			<version>0.38.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
